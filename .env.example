# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Razorpay (TEST MODE ONLY) ---
# Dashboard > Account & Settings > API Keys, with the Test/Live toggle set to Test.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in the Razorpay dashboard; used to verify signatures.
RAZORPAY_WEBHOOK_SECRET=

# --- Local LLM (fallback classifier, narration, message generation) ---
# Open-source model served locally by Ollama. No API key, no network at run time.
#   ollama pull qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
# Hinglish generation is the hardest task for a small model. If 7B output is poor,
# point this at a larger or India-tuned model; see WORKPLAN.md section 3.
LLM_MODEL_HINGLISH=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60

# --- Runtime ---
ENV=dev
DATABASE_URL=sqlite:///./recovery.db
FIXTURES_DIR=fixtures

# --- Reproducibility ---
SEED=42

# --- Safety caps (enforced by the stopping rules; see WORKPLAN.md Day 4) ---
MAX_ATTEMPTS=3
RECOVERY_WINDOW_DAYS=7
# Above this amount (INR) an e-mandate debit needs additional-factor auth.
AFA_THRESHOLD_INR=15000
# Live Razorpay test-API calls are capped so a bug cannot fan out.
LIVE_SUBSET_SIZE=100
